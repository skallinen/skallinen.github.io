{
  "name": "daily-dose-companion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:rules": "node --test firestore-test/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0"
  }
}
