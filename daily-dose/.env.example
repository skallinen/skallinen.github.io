# Reuses Bookrank's Google/Firebase identity. Membership requests use the user's
# Firebase ID token, read-only; no service-account database permissions are used.
# Comma-separated Firebase UIDs allowed to set Day 1 (must also be club members).
DAILY_DOSE_ORGANIZER_UIDS=
PORT=3000
HOST=127.0.0.1
# Persist this directory when deploying. One server instance with SQLite.
DAILY_DOSE_DB=data/daily-dose.sqlite
