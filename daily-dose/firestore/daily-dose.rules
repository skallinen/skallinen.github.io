    // Daily Dose only. Append inside /databases/{database}/documents.
    // Bookrank / Agenda rules are deliberately not replaced by a local template.
    function doseProgram(c) {
      return get(/databases/$(database)/documents/dailyDose/$(c)).data;
    }
    function doseMember(c) {
      return request.auth != null
        && request.auth.uid in doseProgram(c).participantUids
        && exists(/databases/$(database)/documents/clubs/$(c)/members/$(request.auth.uid));
    }
    function doseOrganizer(c) {
      return doseMember(c) && request.auth.uid in doseProgram(c).organizerUids;
    }
    function doseWork(c, w) {
      return get(/databases/$(database)/documents/dailyDose/$(c)/works/$(w)).data;
    }
    function doseReleased(c, w) {
      return doseWork(c, w).openAt is timestamp && doseWork(c, w).openAt <= request.time;
    }
    function doseSubmitted(c, w) {
      return get(/databases/$(database)/documents/dailyDose/$(c)/works/$(w)/reads/$(request.auth.uid)).data.get('submittedAt', null) is timestamp;
    }
    match /dailyDose/{club} {
      allow get: if doseMember(club);
      allow list, create, delete: if false;
      // Scheduling is a trusted organiser action; all reading dates then freeze.
      allow update: if doseOrganizer(club) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids'])
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.size() <= 100
          && request.auth.uid in request.resource.data.participantUids)
        || ((resource.data.startDate == null || resource.data.boundaries[0] > request.time)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate', 'timezone', 'boundaries', 'updatedAt'])
          && request.resource.data.startDate is string && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 100
          && request.resource.data.boundaries is list && request.resource.data.boundaries.size() == 51
          && request.resource.data.boundaries[0] is timestamp
          && request.resource.data.boundaries[0] > request.time - duration.value(26, 'h')
          && request.resource.data.updatedAt == request.time));

      match /sessions/{uid} {
        allow get: if doseMember(club) && request.auth.uid == uid;
        allow create, update: if doseMember(club) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow list, delete: if false;
      }
      match /texts/{work} {
        allow get: if doseMember(club) && doseReleased(club, work);
        allow list, write: if false;
      }
      match /works/{work} {
        allow read: if doseMember(club) && resource.data.openAt >= timestamp.date(1970, 1, 1) && resource.data.openAt <= request.time;
        allow create, delete: if false;
        allow update: if doseOrganizer(club)
            && (doseProgram(club).startDate == null || doseProgram(club).boundaries[0] > request.time)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openAt', 'closeAt'])
            && request.resource.data.openAt == getAfter(/databases/$(database)/documents/dailyDose/$(club)).data.boundaries[resource.data.day - 1]
            && request.resource.data.closeAt == getAfter(/databases/$(database)/documents/dailyDose/$(club)).data.boundaries[resource.data.day];
        match /reads/{uid} {
          function rowShape(d) {
            return d.keys().hasAll(['status', 'startedAt', 'completedAt', 'joinedOnDay', 'comment', 'commentAt', 'updatedAt'])
              && d.keys().hasOnly(['status', 'startedAt', 'completedAt', 'joinedOnDay', 'comment', 'commentAt', 'rating', 'submittedAt', 'updatedAt', 'undoCompletedAt'])
              && (d.get('undoCompletedAt', null) == null || d.undoCompletedAt is timestamp)
              && d.status in ['reading', 'done'] && d.startedAt is timestamp
              && d.joinedOnDay is bool && d.comment is string && d.comment.matches('(?s)^.{0,140}$')
              && (d.get('rating', null) == null || (d.rating is int && d.rating >= 0 && d.rating <= 5))
              && ((d.status == 'reading' && d.completedAt == null) || (d.status == 'done' && d.completedAt is timestamp))
              && (d.get('submittedAt', null) == null || (d.submittedAt is timestamp && d.status == 'done'
                && d.get('rating', null) is int && d.comment.matches('(?s).*\\S.*') && d.commentAt is timestamp))
              && d.updatedAt == request.time;
          }
          function starts(d) {
            return d.status in ['reading', 'done'] && d.startedAt == request.time
              && d.joinedOnDay == (request.time < doseWork(club, work).closeAt)
              && d.comment == '' && d.commentAt == null
              && d.get('rating', null) == null && d.get('submittedAt', null) == null
              && d.get('undoCompletedAt', null) == null
              && ((d.status == 'reading' && d.completedAt == null) || (d.status == 'done' && d.completedAt == request.time));
          }
          function changes(d, old) {
            return (old.status == 'withdrawn' && starts(d))
              || (old.status == 'reading' && d.status == 'done'
                && d.startedAt == old.startedAt && d.joinedOnDay == old.joinedOnDay
                && d.diff(old).affectedKeys().hasOnly(['status', 'completedAt', 'submittedAt', 'updatedAt', 'undoCompletedAt'])
                && d.get('submittedAt', null) == null && d.get('undoCompletedAt', null) == null
                // A fresh checkmark, or Undo of "Mark as unread" within five minutes,
                // which restores the checkmark time that unread set aside.
                && (d.completedAt == request.time
                  || (old.get('undoCompletedAt', null) is timestamp && d.completedAt == old.undoCompletedAt
                    && request.time < old.updatedAt + duration.value(5, 'm'))))
              || (old.status == 'done' && d.status == 'reading' && d.completedAt == null && d.get('submittedAt', null) == null
                && d.diff(old).affectedKeys().hasOnly(['status', 'completedAt', 'submittedAt', 'updatedAt', 'undoCompletedAt'])
                && (d.get('undoCompletedAt', null) == null || d.undoCompletedAt == old.completedAt))
              || (old.status == 'done' && d.status == 'done' && d.completedAt == old.completedAt
                && d.startedAt == old.startedAt && d.joinedOnDay == old.joinedOnDay
                && d.diff(old).affectedKeys().hasOnly(['comment', 'commentAt', 'rating', 'submittedAt', 'updatedAt'])
                && (d.get('submittedAt', null) == old.get('submittedAt', null) || d.get('submittedAt', null) == null
                  || (old.get('submittedAt', null) == null && d.submittedAt == request.time))
                && ((d.comment == old.comment && d.commentAt == old.commentAt) || d.commentAt == request.time));
          }
          allow get: if doseMember(club) && (request.auth.uid == uid || (doseReleased(club, work)
            && doseSubmitted(club, work) && resource.data.get('submittedAt', null) is timestamp));
          // Query only submittedAt >= epoch. Never list drafts, even one's own.
          allow list: if doseMember(club) && doseReleased(club, work) && doseSubmitted(club, work)
            && resource.data.submittedAt >= timestamp.date(1970, 1, 1);
          allow create: if doseMember(club) && request.auth.uid == uid && doseReleased(club, work)
            && rowShape(request.resource.data) && starts(request.resource.data);
          allow update: if doseMember(club) && request.auth.uid == uid && doseReleased(club, work)
            && rowShape(request.resource.data) && changes(request.resource.data, resource.data);
          allow delete: if false;
        }
        // Emoji reactions to the submitted thoughts on this text: one document
        // per reacting member, { on: { authorUid: [keys] }, last, updatedAt }.
        // Visible exactly where the thoughts are: to members who have
        // submitted their own response to this text. Each write is the
        // member's own document and changes one author's list (`last`); a new
        // reaction needs that author's thought to be submitted now. Removing
        // is always possible. The keys repeat client/reactions.mjs.
        match /reactions/{uid} {
          function reactionsBefore() {
            return resource == null ? {} : resource.data.on;
          }
          function reactionList(d) {
            return d.on.get(d.last, []);
          }
          allow read: if doseMember(club) && doseReleased(club, work) && doseSubmitted(club, work);
          allow create, update: if doseMember(club) && request.auth.uid == uid
            && doseReleased(club, work) && doseSubmitted(club, work)
            && request.resource.data.keys().hasAll(['on', 'last', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['on', 'last', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.on is map && request.resource.data.on.size() <= 100
            && request.resource.data.last is string && request.resource.data.last.matches('^[A-Za-z0-9_-]{1,128}$')
            && request.resource.data.on.diff(reactionsBefore()).affectedKeys().hasOnly([request.resource.data.last])
            && reactionList(request.resource.data) is list
            && reactionList(request.resource.data).size() <= 6
            && reactionList(request.resource.data).hasOnly(['heart', 'like', 'laugh', 'wow', 'moved', 'think'])
            && reactionList(request.resource.data).toSet().size() == reactionList(request.resource.data).size()
            && (reactionList(request.resource.data).toSet().difference(reactionsBefore().get(request.resource.data.last, []).toSet()).size() == 0
              || get(/databases/$(database)/documents/dailyDose/$(club)/works/$(work)/reads/$(request.resource.data.last)).data.get('submittedAt', null) is timestamp);
          allow delete: if false;
        }
      }
      // Completion records: one per member, a map of work id to checkmark time.
      // The organiser may read them to see who has checked which text off and
      // when; they never contain ratings, thoughts, drafts or reading progress.
      // Every change must equal the owner's own private row after the write.
      match /completions/{uid} {
        function doseRowAfter(w) {
          return getAfter(/databases/$(database)/documents/dailyDose/$(club)/works/$(w)/reads/$(uid)).data;
        }
        function doseChecks() {
          return resource == null ? {} : resource.data.works;
        }
        allow get: if doseMember(club) && (request.auth.uid == uid || doseOrganizer(club));
        allow list: if doseOrganizer(club);
        allow create, update: if doseMember(club) && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['works', 'last'])
          && request.resource.data.keys().hasOnly(['works', 'last'])
          && request.resource.data.works is map && request.resource.data.works.size() <= 150
          && request.resource.data.last is string && request.resource.data.last.matches('^[A-Za-z0-9-]{1,40}$')
          && request.resource.data.works.diff(doseChecks()).affectedKeys().hasOnly([request.resource.data.last])
          && ((request.resource.data.last in request.resource.data.works
              && doseRowAfter(request.resource.data.last).status == 'done'
              && request.resource.data.works[request.resource.data.last] == doseRowAfter(request.resource.data.last).completedAt)
            || (!(request.resource.data.last in request.resource.data.works)
              && doseRowAfter(request.resource.data.last).status != 'done'));
        allow delete: if false;
      }
      match /gates/{work} {
        // Retired shared gates remain untouched, inaccessible and unused.
        allow read, write: if false;
      }
    }
