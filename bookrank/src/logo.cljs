(defn mark
  "The mark as hiccup. `class-name` sizes it (height; width follows —
   the artwork is ~3:2 landscape). Decorative: every placement sits
   beside the BookRank wordmark, so it is hidden from assistive tech
   rather than announced twice."
  [class-name]
  [:svg {:class       class-name
         :viewBox     "0 0 670 446"
         :fill        "currentColor"
         :aria-hidden "true"
         :focusable   "false"}
   [:path {:d path-d}]])
